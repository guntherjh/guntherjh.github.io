<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ metadata.title }}</title>
  <meta name="description" content="{{ description or metadata.description }}">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="alternate" type="application/rss+xml" title="{{ metadata.title }}" href="{{ metadata.url }}/feed.xml">
  <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
  <!-- iOS's "Add to Home Screen" doesn't read the manifest's icons at
       all — needs its own dedicated PNG link. -->
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <!-- Matches style.css's light/dark tokens (--color-bg) — colors the
       browser's own UI chrome (address bar, task switcher), independent
       of manifest.webmanifest's static theme_color/background_color,
       which only apply once the site is installed. -->
  <meta name="theme-color" content="#f2f2f4" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#2d2d30" media="(prefers-color-scheme: dark)">
  <script>
    // Sets [data-theme] before first paint, deliberately inline (not an
    // external/deferred file) — an external script would load after the
    // initial render and cause a visible flash of the wrong theme.
    // Interaction logic (the toggle itself) lives in
    // /js/theme-toggle.js; this only decides the *initial* theme.
    (function () {
      var stored = null;
      try {
        stored = localStorage.getItem("theme");
      } catch {}
      var effective =
        stored || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", effective);
    })();
  </script>
  <script>
    // Captures `beforeinstallprompt` as early as possible — it can fire
    // before the deferred /js/install-button.js runs, and the event
    // can't be retrieved afterward. Stashed on window here; the deferred
    // script consumes it (same inline-capture pattern as the theme
    // script above). Chromium-only event; no-op everywhere else.
    window.addEventListener("beforeinstallprompt", function (e) {
      e.preventDefault();
      window.__installPromptEvent = e;
    });
  </script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <header class="site-header">
    <a class="site-title" href="/">{{ metadata.title }}</a>

    <!-- Desktop: always-visible nav + toggle, hidden below the mobile
         breakpoint (see style.css). Independent from the mobile copy
         below — plain display:none/flex toggling only, not relying on
         overriding <details>'s native closed-content hiding, which
         turned out not to be reliably overridable that way.

         DUPLICATE MARKUP WARNING: the nav links, install button, and
         toggle button here are repeated verbatim in the mobile
         <details> block below. Keep both in sync — adding/removing a
         nav link or changing the install/toggle button markup means
         editing both copies. -->
    <div class="site-header-controls">
      <nav class="site-nav">
        <a href="/">Home</a>
        <a href="/about/">About</a>
        <a href="/resume/">Resume</a>
        <a href="/blog/">Blog</a>
      </nav>
      <!-- Unhidden by /js/install-button.js only when the browser has
           offered a PWA install (Chromium only). The ⓘ opens a plain-
           language explanation via the same native-Popover toggletip
           pattern as the Lighthouse Widget's metric ⓘ (ADR 0007 / ADR
           0008); its panel is the single #install-help <span popover>
           below, shared with the mobile copy since only one control
           block is ever visible at a time. -->
      <span class="install-control" hidden>
        <button type="button" class="install-button" aria-describedby="install-help">Install app</button>
        <button type="button" class="install-help" popovertarget="install-help" aria-label="About installing this site" aria-describedby="install-help"><span aria-hidden="true">ⓘ</span></button>
      </span>
      <button type="button" class="theme-toggle" role="switch" aria-checked="false" aria-label="Dark mode">
        <span class="theme-toggle-thumb" aria-hidden="true"></span>
      </button>
    </div>

    <!-- Mobile: hamburger + overlay panel (position: absolute, doesn't
         affect header height when open), hidden above the breakpoint.
         DUPLICATE MARKUP — see the matching warning on
         .site-header-controls above; keep both copies in sync. -->
    <details class="nav-toggle">
      <summary class="nav-toggle-summary" aria-label="Menu">
        <span aria-hidden="true">☰</span>
      </summary>
      <div class="nav-toggle-panel">
        <nav class="site-nav">
          <a href="/">Home</a>
          <a href="/about/">About</a>
          <a href="/resume/">Resume</a>
          <a href="/blog/">Blog</a>
        </nav>
        <!-- DUPLICATE — see .site-header-controls above; keep in sync.
             Both .install-help ⓘ triggers point at the one #install-help
             popover below. -->
        <span class="install-control" hidden>
          <button type="button" class="install-button" aria-describedby="install-help">Install app</button>
          <button type="button" class="install-help" popovertarget="install-help" aria-label="About installing this site" aria-describedby="install-help"><span aria-hidden="true">ⓘ</span></button>
        </span>
        <button type="button" class="theme-toggle" role="switch" aria-checked="false" aria-label="Dark mode">
          <span class="theme-toggle-thumb" aria-hidden="true"></span>
        </button>
      </div>
    </details>

    <!-- One shared panel for both .install-control ⓘ triggers above
         (desktop + mobile) — only one control block is ever visible, so a
         single popover id is enough, same as the Lighthouse Widget's ⓘ
         panels. Also the target of each Install button's
         aria-describedby, so the explanation still reaches assistive tech
         in a browser without Popover API support. -->
    <span popover id="install-help" class="install-help-detail">Adds this site to your device as a standalone app: it opens in its own window, works offline, and gets a launcher icon. Nothing is downloaded from an app store.</span>
  </header>

  <main class="site-main" id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>&copy; {{ buildTime | copyrightDate }} {{ metadata.title }}. <a href="/feed.xml">RSS</a></p>
  </footer>

  <!-- No defer: this is the last thing in <body>, so nothing else is
       blocked, and running it as soon as the parser reaches this point
       (rather than waiting for defer's "after full document parse"
       timing) tightens the window before aria-checked is corrected to
       match the already-painted theme (see the CSS comment on
       html[data-theme="dark"] .theme-toggle for why the switch's
       *visual* state doesn't depend on this timing at all). -->
  <script src="/js/theme-toggle.js"></script>
  <script src="/js/nav-toggle.js" defer></script>
  <script src="/js/register-sw.js" defer></script>
  <script src="/js/install-button.js" defer></script>
</body>
</html>
